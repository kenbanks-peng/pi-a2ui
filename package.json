{
  "name": "@npm-ken/pi-a2ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Live A2UI graphics beside pi in terminal-browser",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "preview": "node scripts/preview.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.6.0",
    "@earendil-works/pi-coding-agent": ">=1.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@a2ui/agent": "^0.1.0",
    "@a2ui/lit": "^0.15.0",
    "@a2ui/web_core": "^0.15.0",
    "esbuild": "^0.28.2",
    "lit": "^3.3.3",
    "typebox": "^1.3.27"
  }
}
